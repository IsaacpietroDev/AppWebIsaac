@page "/processos"
@using AppWebIsaac.DAO
@using AppWebIsaac.Model
@inject ProcessoDAO dao

<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Consulta de Processos</h2>
    </div>
    <div>
        <a href="/processos/cadastro" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Novo Processo
        </a>
    </div>
</div>

@if (erro is not null)
{
    <div class="alert alert-danger">Não foi possível carregar os processos: @erro</div>
}

<div class="custom-table-card">
    <div class="table-responsive">

        <table class="table align-middle mb-0">

            <thead>
                <tr>
                    <th>Id</th>
                    <th>Número</th>
                    <th>Data</th>
                    <th>Interessado</th>
                    <th>Assunto</th>
                    <th>Situação</th>
                </tr>
            </thead>
            <tbody>
                @if (processos.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Nenhum processo cadastrado.</td>
                    </tr>
                }
                @foreach (var p in processos)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Numero</td>
                        <td>@p.Data?.ToString("dd/MM/yyyy")</td>
                        <td>@p.Interessado</td>
                        <td>@p.Assunto</td>
                        <td>@p.Situacao</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

@code {
    private List<Processo> processos = new();
    private string? erro;

    protected override void OnInitialized()
    {
        try
        {
            processos = dao.Listar();
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
    }
}
